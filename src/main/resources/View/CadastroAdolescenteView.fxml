<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" stylesheets="@adolescentes-style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.unespar.trabalho.controller.CadastroAdolescenteController">

    <!-- MENU LATERAL ESQUERDO -->
    <left>
        <VBox styleClass="sidebar" prefWidth="240.0" spacing="10.0">
            <padding>
                <Insets top="25.0" bottom="25.0" left="20.0" right="20.0" />
            </padding>
            <VBox spacing="2.0">
                <Label text="INSTITUTO" styleClass="sidebar-logo-sub" />
                <Label text="C.A.S.A." styleClass="sidebar-logo-main" />
                <VBox.margin><Insets bottom="30.0" /></VBox.margin>
            </VBox>
            <Button text="Painel" styleClass="nav-button" maxWidth="Infinity" alignment="TOP_LEFT" onAction="#irParaPainel" />
            <Button text="Adolescentes" styleClass="nav-button-active" maxWidth="Infinity" alignment="TOP_LEFT" onAction="#voltarParaLista" />
            <Button text="Agenda" styleClass="nav-button" maxWidth="Infinity" alignment="TOP_LEFT" onAction="#irParaAgenda" />
            <Button text="Relatórios" styleClass="nav-button" maxWidth="Infinity" alignment="TOP_LEFT" onAction="#irParaRelatorios" />
            <Button text="Equipe Técnica" styleClass="nav-button" maxWidth="Infinity" alignment="TOP_LEFT" onAction="#irParaEquipeTecnica" />

            <Region VBox.vgrow="ALWAYS" />

            <VBox spacing="15.0" styleClass="user-box">
                <HBox spacing="12.0" alignment="CENTER_LEFT">
                    <Circle radius="18.0" styleClass="user-avatar" />
                    <VBox spacing="2.0">
                        <Label text="Usuário Logado" styleClass="user-name" />
                        <Label text="Sessão Ativa" styleClass="user-role" />
                    </VBox>
                </HBox>
                <Button text="Sair do sistema" styleClass="logout-button" onAction="#fazerLogout" maxWidth="Infinity" alignment="CENTER_LEFT" />
            </VBox>
        </VBox>
    </left>

    <!-- CONTEÚDO CENTRAL -->
    <center>
        <VBox styleClass="main-content" spacing="20.0">
            <padding>
                <Insets top="30.0" bottom="30.0" left="40.0" right="40.0" />
            </padding>

            <HBox>
                <Button text="&lt; Voltar para lista" styleClass="back-link" onAction="#voltarParaLista" />
            </HBox>

            <VBox spacing="4.0">
                <Label text="Novo Cadastro" styleClass="page-title" />
                <Label text="Preencha os dados básicos do adolescente." styleClass="page-subtitle" />
            </VBox>

            <VBox styleClass="content-box" spacing="20.0" VBox.vgrow="ALWAYS">
                <Label text="Informações Pessoais" styleClass="box-title" />

                <HBox spacing="20.0">
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label text="NOME COMPLETO *" styleClass="form-label-mini" />
                        <TextField fx:id="txtNome" promptText="Nome do adolescente" styleClass="search-field" />
                    </VBox>
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label text="CPF *" styleClass="form-label-mini" />
                        <TextField fx:id="txtCpf" promptText="Somente números" styleClass="search-field" />
                    </VBox>
                </HBox>

                <HBox spacing="20.0">
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label text="DATA DE NASCIMENTO *" styleClass="form-label-mini" />
                        <DatePicker fx:id="dpNascimento" styleClass="search-field" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label text="TELEFONE/CONTATO" styleClass="form-label-mini" />
                        <TextField fx:id="txtContato" promptText="(00) 00000-0000" styleClass="search-field" />
                    </VBox>
                </HBox>

                <HBox spacing="20.0">
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label text="E-MAIL" styleClass="form-label-mini" />
                        <TextField fx:id="txtEmail" promptText="email@exemplo.com" styleClass="search-field" />
                    </VBox>
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label text="NATURALIDADE" styleClass="form-label-mini" />
                        <TextField fx:id="txtNaturalidade" promptText="Cidade/Estado" styleClass="search-field" />
                    </VBox>
                </HBox>

                <HBox spacing="20.0">
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label text="GÊNERO" styleClass="form-label-mini" />
                        <ComboBox fx:id="cmbGenero" styleClass="search-field" maxWidth="Infinity" />
                    </VBox>
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label text="COR/RAÇA" styleClass="form-label-mini" />
                        <ComboBox fx:id="cmbCorRaca" styleClass="search-field" maxWidth="Infinity" />
                    </VBox>
                </HBox>

                <Region VBox.vgrow="ALWAYS" />

                <!-- Botões de Ação -->
                <HBox spacing="15.0" alignment="CENTER_RIGHT">
                    <Button text="Cancelar" styleClass="filter-btn" onAction="#voltarParaLista" />
                    <Button text="Salvar Cadastro" styleClass="btn-novo" onAction="#salvarAdolescente" />
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>