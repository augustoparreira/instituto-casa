<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" stylesheets="@relatorios-style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.unespar.trabalho.controller.RelatoriosController">

    <!-- MENU LATERAL ESQUERDO -->
    <left>
        <VBox styleClass="sidebar" prefWidth="240.0" spacing="10.0">
            <padding>
                <Insets top="25.0" bottom="25.0" left="20.0" right="20.0" />
            </padding>
            <VBox spacing="2.0">
                <Label text="INSTITUTO" styleClass="sidebar-logo-sub" />
                <Label text="C.A.S.A." styleClass="sidebar-logo-main" />
                <VBox.margin><Insets bottom="30.0" /></VBox.margin>
            </VBox>

            <Button text="Painel" styleClass="nav-button" maxWidth="Infinity" alignment="TOP_LEFT" onAction="#irParaPainel" />
            <Button text="Adolescentes" styleClass="nav-button" maxWidth="Infinity" alignment="TOP_LEFT" onAction="#irParaAdolescentes" />
            <Button text="Agenda" styleClass="nav-button" maxWidth="Infinity" alignment="TOP_LEFT" onAction="#irParaAgenda" />
            <Button text="Relatórios" styleClass="nav-button-active" maxWidth="Infinity" alignment="TOP_LEFT" onAction="#irParaRelatorios" />
            <Button text="Equipe Técnica" styleClass="nav-button" maxWidth="Infinity" alignment="TOP_LEFT" onAction="#irParaEquipeTecnica" />

            <Region VBox.vgrow="ALWAYS" />

            <VBox spacing="15.0" styleClass="user-box">
                <HBox spacing="12.0" alignment="CENTER_LEFT">
                    <Circle radius="18.0" styleClass="user-avatar" />
                    <VBox spacing="2.0">
                        <Label fx:id="lblNomeUsuario" text="Gabriel Henrique" styleClass="user-name" />
                        <Label fx:id="lblCargoUsuario" text="Administrador" styleClass="user-role" />
                    </VBox>
                </HBox>
                <Button text="Sair do sistema" styleClass="logout-button" onAction="#fazerLogout" maxWidth="Infinity" alignment="CENTER_LEFT" />
            </VBox>
        </VBox>
    </left>

    <!-- CONTEÚDO CENTRAL -->
    <center>
        <VBox styleClass="main-content" spacing="20.0">
            <padding>
                <Insets top="30.0" bottom="30.0" left="40.0" right="40.0" />
            </padding>

            <!-- Cabeçalho -->
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="4.0">
                    <Label text="Relatórios Institucionais" styleClass="page-title" />
                    <Label fx:id="lblNivelAcessoInfo" text="Nível de Acesso: Administrador (Acesso Total)" styleClass="page-subtitle" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnNovoRelatorio" text="+ Gerar Novo Relatório" styleClass="btn-novo-evento" onAction="#gerarNovoRelatorio" />
            </HBox>

            <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                <!-- Lista de Relatórios Gerados (Esquerda) -->
                <VBox styleClass="content-box" prefWidth="450.0" spacing="15.0">
                    <Label text="Relatórios Cadastrados" styleClass="box-title" />
                    <HBox spacing="10.0">
                        <ComboBox fx:id="cmbTipoFiltro" promptText="Filtrar por tipo..." styleClass="month-combo" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                    </HBox>
                    <ListView fx:id="listRelatorios" VBox.vgrow="ALWAYS" styleClass="custom-list-view" />
                </VBox>

                <!-- Painel de Visualização e Edição de Dados (Direita) -->
                <VBox styleClass="content-box" HBox.hgrow="ALWAYS" spacing="15.0">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Detalhamento e Atualização" styleClass="box-title" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblStatusEdicao" text="Modo: Visualização" styleClass="selected-date-sub" />
                    </HBox>
                    <Separator />

                    <VBox spacing="10.0">
                        <Label text="Título do Relatório" styleClass="form-label-mini" />
                        <TextField fx:id="txtTituloRelatorio" promptText="Título do relatório" styleClass="search-field" />

                        <Label text="Adolescente / Categoria de Acompanhamento" styleClass="form-label-mini" />
                        <TextField fx:id="txtCategoriaRelatorio" promptText="Ex: Lucas Henrique / Medidas Cumpridas" styleClass="search-field" />

                        <Label text="Parecer Técnico / Observações" styleClass="form-label-mini" />
                        <TextArea fx:id="txtParecerTecnico" promptText="Digite aqui as observações ou parecer do relatório..." prefHeight="220.0" styleClass="search-field" wrapText="true" />
                    </VBox>

                    <Region VBox.vgrow="ALWAYS" />

                    <!-- Botões de Ação Condicionados ao Nível do Usuário -->
                    <HBox spacing="10.0" alignment="CENTER_RIGHT">
                        <Button fx:id="btnExcluirRelatorio" text="Excluir Relatório" styleClass="btn-excluir" onAction="#excluirRelatorio" visible="true" />
                        <Button fx:id="btnExportar" text="Exportar PDF" styleClass="btn-novo-evento" onAction="#exportarPDF" />
                        <Button fx:id="btnSalvarAtualizacao" text="Salvar Alterações" styleClass="btn-novo-evento" onAction="#salvarAtualizacaoRelatorio" />
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>