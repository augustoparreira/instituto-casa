<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" stylesheets="@relatorios-style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.edu.unespar.trabalho.controller.RelatoriosController">

    <!-- MENU LATERAL ESQUERDO -->
    <left>
        <VBox styleClass="sidebar" prefWidth="240.0" spacing="10.0">
            <padding>
                <Insets top="25.0" bottom="25.0" left="20.0" right="20.0" />
            </padding>
            <VBox spacing="2.0">
                <Label text="INSTITUTO" styleClass="sidebar-logo-sub" />
                <Label text="C.A.S.A." styleClass="sidebar-logo-main" />
                <VBox.margin><Insets bottom="30.0" /></VBox.margin>
            </VBox>

            <Button text="Painel" styleClass="nav-button" maxWidth="Infinity" alignment="TOP_LEFT" onAction="#irParaPainel" />
            <Button text="Adolescentes" styleClass="nav-button" maxWidth="Infinity" alignment="TOP_LEFT" onAction="#irParaAdolescentes" />
            <Button text="Agenda" styleClass="nav-button" maxWidth="Infinity" alignment="TOP_LEFT" onAction="#irParaAgenda" />
            <Button text="Relatórios" styleClass="nav-button-active" maxWidth="Infinity" alignment="TOP_LEFT" onAction="#irParaRelatorios" />
            <Button text="Equipe Técnica" styleClass="nav-button" maxWidth="Infinity" alignment="TOP_LEFT" onAction="#irParaEquipeTecnica" />

            <Region VBox.vgrow="ALWAYS" />

            <VBox spacing="15.0" styleClass="user-box">
                <HBox spacing="12.0" alignment="CENTER_LEFT">
                    <Circle radius="18.0" styleClass="user-avatar" />
                    <VBox spacing="2.0">
                        <Label fx:id="lblNomeUsuario" text="Gabriel Henrique" styleClass="user-name" />
                        <Label fx:id="lblCargoUsuario" text="Administrador" styleClass="user-role" />
                    </VBox>
                </HBox>
                <Button text="Sair do sistema" styleClass="logout-button" onAction="#fazerLogout" maxWidth="Infinity" alignment="CENTER_LEFT" />
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox styleClass="main-content" spacing="14">
            <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>
            <Label text="Relatório de acompanhamento" styleClass="page-title"/>
            <Label text="Medida socioeducativa · relatório mensal para revisão e encaminhamento ao Judiciário" styleClass="page-subtitle" wrapText="true"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <ComboBox fx:id="cmbAdolescente" promptText="Selecione o adolescente" maxWidth="Infinity" HBox.hgrow="ALWAYS" minWidth="0" styleClass="month-combo"/>
                <DatePicker fx:id="dpCompetencia" prefWidth="140"/>
                <Button text="Preparar novo" onAction="#gerarNovoRelatorio" styleClass="btn-novo-evento"/>
            </HBox>
            <Label fx:id="lblMensagem" wrapText="true" styleClass="page-subtitle"/>
            <HBox spacing="18" VBox.vgrow="ALWAYS">
                <VBox styleClass="content-box" prefWidth="250" minWidth="220" maxWidth="250" spacing="10">
                    <Label text="Rascunhos salvos" styleClass="box-title-mini"/>
                    <TextField fx:id="txtPesquisa" promptText="Nome, mês/ano ou número"/>
                    <ListView fx:id="listRelatorios" VBox.vgrow="ALWAYS" styleClass="relatorios-lista"/>
                    <Button text="Excluir selecionado" onAction="#excluirRelatorio" styleClass="btn-excluir" maxWidth="Infinity"/>
                </VBox>
                <VBox styleClass="content-box" HBox.hgrow="ALWAYS" minWidth="0" spacing="12">
                    <Label fx:id="lblStatusEdicao" text="Prepare um relatório ou abra um rascunho salvo" styleClass="selected-date-sub" wrapText="true"/>
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                        <content><VBox spacing="12" style="-fx-padding: 8;">
                            <Label text="Identificação" styleClass="event-title-bold"/>
                            <GridPane fx:id="gridIdentificacao" hgap="10" vgap="8">
                                <columnConstraints><ColumnConstraints percentWidth="35"/><ColumnConstraints percentWidth="65" hgrow="ALWAYS"/></columnConstraints>
                            </GridPane>
                            <Label text="1. REGISTRO DE FREQUÊNCIA" styleClass="event-title-bold"/>
                            <Label text="Preenchido com os lançamentos da competência. Revise e complemente o texto." styleClass="page-subtitle" wrapText="true"/>
                            <TextArea fx:id="txtRegistroFrequencia" prefRowCount="7" wrapText="true"/>
                            <Label text="2. DESCUMPRIMENTO DA MEDIDA E CONTATO COM A FAMÍLIA E ACORDO FIRMADO" styleClass="event-title-bold" wrapText="true"/>
                            <TextArea fx:id="txtDescumprimento" prefRowCount="6" wrapText="true" promptText="Descreva a situação, o contato com a família e o acordo firmado. Se não houve descumprimento, informe isso após avaliação."/>
                            <HBox spacing="10" alignment="CENTER_LEFT"><Label text="Data de emissão" styleClass="event-title-bold"/><DatePicker fx:id="dpEmissao"/></HBox>
                        </VBox></content>
                    </ScrollPane>
                    <HBox spacing="8" alignment="CENTER_RIGHT">
                        <Button text="Visualizar" onAction="#visualizarRelatorio"/>
                        <Button text="Salvar rascunho" onAction="#salvarAtualizacaoRelatorio" styleClass="btn-novo-evento"/>
                        <Button text="Exportar TXT" onAction="#exportarTexto" styleClass="btn-novo-evento"/>
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
